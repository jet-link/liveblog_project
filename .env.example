# Copy to `.env` and adjust. Never commit real secrets.

# --- Local development (example) ---
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_SECRET_KEY=local-dev-key-not-for-production

# --- Django (production) ---
DJANGO_DEBUG=false
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Comma-separated, no spaces: yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Full URLs with scheme, comma-separated (needed behind HTTPS / reverse proxy):
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Set to false only if TLS is terminated elsewhere and redirect loops occur:
# DJANGO_SECURE_SSL_REDIRECT=true
# Optional HSTS preload (enable only after you are sure everything is HTTPS):
# SECURE_HSTS_PRELOAD=true

# --- Database: PostgreSQL ---
DJANGO_DB_NAME=liveblog
DJANGO_DB_USER=your_db_user
DJANGO_DB_PASSWORD=your_db_password
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# Optional: Redis cache (LocMem if unset)
# REDIS_URL=redis://127.0.0.1:6379/1

# Celery (defaults work with local Redis)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Spellcheck UI language
# SPELLCHECK_LANG=en
